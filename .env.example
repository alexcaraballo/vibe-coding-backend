# Application Configuration
APP_NAME="Vibe Coding Carpooling API"
APP_VERSION="0.1.0"
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./carpooling.db
# For in-memory testing: sqlite+aiosqlite:///:memory:
# For specific path: sqlite+aiosqlite:///./data/carpooling.db

# Authentication & Security
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External Services (optional for MVP)
MAPS_API_KEY=
MAPS_PROVIDER=openstreetmap
GEOCODING_API_KEY=

# Matching Engine Configuration
DEFAULT_MAX_DETOUR_MINUTES=30
DEFAULT_PROXIMITY_RADIUS_KM=10.0

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5173"]
